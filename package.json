{
  "name": "kibitz",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts && node scripts/verify-build.mjs && node scripts/bundle-report.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle:report": "node scripts/bundle-report.mjs",
    "bundle:check": "node scripts/bundle-report.mjs --check"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "stockfish": "17.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9",
    "jsdom": "^25.0.1"
  }
}
